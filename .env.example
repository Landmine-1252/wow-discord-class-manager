# Copy this file to .env. Keep .env private; never commit it.
# Required: configure exactly ONE nonempty token source. No "Bot " prefix.
DISCORD_BOT_TOKEN=replace-with-your-discord-bot-token
# Alternative: mounted UTF-8 token file; unset/empty DISCORD_BOT_TOKEN first.
# DISCORD_BOT_TOKEN_FILE=/run/secrets/discord_bot_token
# Optional application ID; normally discovered automatically from the token.
DISCORD_APPLICATION_ID=

# Comma-separated server IDs. Empty permits every server installing this app.
ALLOWED_GUILD_IDS=
# Optional development server ID; required for COMMAND_SYNC_SCOPE=guild.
DEVELOPMENT_GUILD_ID=
# global (normal deployment) or guild (development server only).
COMMAND_SYNC_SCOPE=global

# Character management is enabled by default; false restores the class dropdown.
ENABLE_CHARACTER_MANAGEMENT=true
# Dedicated character slash group; distinct from /class and enabled /roster.
CHARACTER_COMMAND_ROOT=character
# Per-member, per-guild character limit. 0 means unlimited; lists are paginated.
MAX_CHARACTERS_PER_USER=0
# Application name-policy limits, not a claim about Blizzard's exact limits.
# Each minimum must be <= its maximum; allowed configuration range is 1..50.
CHARACTER_PRIMARY_NAME_MIN_LENGTH=2
CHARACTER_PRIMARY_NAME_MAX_LENGTH=12
CHARACTER_SECONDARY_NAME_MIN_LENGTH=2
CHARACTER_SECONDARY_NAME_MAX_LENGTH=12
# Optional guild-wide /roster command; members always retain their private roster.
ENABLE_GUILD_ROSTER=true
# members, admins (Manage Server), or disabled.
ROSTER_VISIBILITY=members
# Character panel title; PANEL_TITLE below remains the legacy class-only title.
CHARACTER_PANEL_TITLE='World of Warcraft Character Manager'
# Allow members to change a registered character's class; names remain editable.
ALLOW_CHARACTER_CLASS_EDIT=true

# Stable IDs; order controls the dropdown. Modern classes are opt-in.
ENABLED_CLASSES=warrior,paladin,hunter,rogue,priest,shaman,mage,warlock,druid
# Create missing safe roles automatically (true/false).
AUTO_CREATE_ROLES=true
# Only {name} is supported. Individual overrides below take precedence.
ROLE_NAME_TEMPLATE='{name}'

# Optional name overrides for every available class (defaults shown).
# ROLE_NAME_WARRIOR=Warrior
# ROLE_NAME_PALADIN=Paladin
# ROLE_NAME_HUNTER=Hunter
# ROLE_NAME_ROGUE=Rogue
# ROLE_NAME_PRIEST=Priest
# ROLE_NAME_SHAMAN=Shaman
# ROLE_NAME_MAGE=Mage
# ROLE_NAME_WARLOCK=Warlock
# ROLE_NAME_DRUID=Druid
# ROLE_NAME_DEATH_KNIGHT=Death Knight
# ROLE_NAME_MONK=Monk
# ROLE_NAME_DEMON_HUNTER=Demon Hunter
# ROLE_NAME_EVOKER=Evoker

# Optional six-digit color overrides (official defaults shown).
# ROLE_COLOR_WARRIOR='#C69B6D'
# ROLE_COLOR_PALADIN='#F48CBA'
# ROLE_COLOR_HUNTER='#AAD372'
# ROLE_COLOR_ROGUE='#FFF468'
# ROLE_COLOR_PRIEST='#FFFFFF'
# ROLE_COLOR_SHAMAN='#0070DD'
# ROLE_COLOR_MAGE='#3FC7EB'
# ROLE_COLOR_WARLOCK='#8788EE'
# ROLE_COLOR_DRUID='#FF7C0A'
# ROLE_COLOR_DEATH_KNIGHT='#C41E3A'
# ROLE_COLOR_MONK='#00FF98'
# ROLE_COLOR_DEMON_HUNTER='#A330C9'
# ROLE_COLOR_EVOKER='#33937F'

# Native embed and select text. Single quotes preserve literal $ and #.
PANEL_TITLE='Choose Your Class'
# Leave unset to choose the default for the enabled panel mode. To customize:
# PANEL_DESCRIPTION='Register your main character and alts, manage your characters, and change mains whenever you want. Your main character determines your Discord class color.'
PANEL_PLACEHOLDER='Select your class...'
# Optional footer; empty hides it.
PANEL_FOOTER=
PANEL_ACCENT_COLOR='#5865F2'

# Commands: 1–32 lowercase ASCII letters, digits, _ or -; unique subcommands.
SLASH_COMMAND_ROOT=class
SLASH_SETUP_NAME=setup
SLASH_SYNC_NAME=sync
SLASH_STATUS_NAME=status
SLASH_SET_NAME=set
SLASH_ME_NAME=me
SLASH_CLEAR_NAME=clear
SLASH_HELP_NAME=help

# Allow removing the last registered character, or clearing a legacy selection.
ALLOW_CLEAR_SELECTION=false
# Minimum seconds between attempts by one member; 0 disables, maximum 3600.
ROLE_CHANGE_COOLDOWN_SECONDS=3
# DEBUG, INFO, WARNING, ERROR or CRITICAL. Payload debug logging stays disabled.
LOG_LEVEL=INFO
# Optional secret outbound webhook; only https://discord.com/api/webhooks/ID/TOKEN.
# ADMIN_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
ADMIN_WEBHOOK_URL=

# Absolute local paths; default Compose mounts /data persistently and /tmp as tmpfs.
DATABASE_PATH=/data/classes.sqlite3
HEALTH_PATH=/tmp/wow-class-manager-health.json
# Compose-only image reference; after publication prefer a release or digest.
BOT_IMAGE=ghcr.io/landmine-1252/wow-discord-class-manager:1.1.0
